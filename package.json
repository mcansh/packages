{
  "name": "packages",
  "private": true,
  "license": "MIT",
  "author": "Logan McAnsh <logan@mcan.sh> (https://mcan.sh/)",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm run --recursive --parallel --filter \"./packages/**\" build",
    "build:apps": "pnpm run --recursive --parallel --filter \"./apps/**\" build",
    "build": "pnpm run --sequential \"/^build:.*/\"",
    "changeset": "changeset",
    "changeset:release": "pnpm run build && changeset publish",
    "changeset:version": "changeset version && node ./scripts/remove-prerelease-changelogs.js && pnpm install --lockfile-only",
    "dev": "pnpm run --filter http-helmet --filter example-app --recursive --parallel dev",
    "dev:vite": "pnpm run --filter http-helmet --filter example-vite-app --recursive --parallel dev",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "prepublishOnly": "pnpm run build",
    "publish": "./scripts/publish.js",
    "test": "vitest",
    "test:ci": "vitest --coverage",
    "typecheck": "pnpm run --recursive typecheck",
    "validate": "run-p build lint format typecheck"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.5",
    "@manypkg/get-packages": "^3.0.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chalk": "^5.4.1",
    "jsonfile": "^6.1.0",
    "junit": "^1.4.9",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "^0.0.54",
    "prompt-confirm": "^2.0.4",
    "semver": "^7.7.2",
    "typedoc": "^0.28.7",
    "vitest": "catalog:",
    "wrangler": "^4.25.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.9.1",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
