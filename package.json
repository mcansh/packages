{
  "private": true,
  "name": "packages",
  "author": "Logan McAnsh <logan@mcan.sh> (https://mcan.sh/)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm run --recursive --parallel --filter \"./packages/**\" build",
    "build:apps": "pnpm run --recursive --parallel --filter \"./apps/**\" build",
    "build": "pnpm run --sequential \"/^build:.*/\"",
    "changeset": "changeset",
    "changeset:release": "pnpm run build && changeset publish",
    "changeset:version": "changeset version && node ./scripts/remove-prerelease-changelogs.js && pnpm install --lockfile-only",
    "dev": "pnpm run --filter http-helmet --filter example-app --recursive --parallel dev",
    "dev:vite": "pnpm run --filter http-helmet --filter example-vite-app --recursive --parallel dev",
    "format": "prettier --cache --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "lint": "pnpm run --recursive --parallel lint",
    "prepublishOnly": "pnpm run build",
    "publish": "./scripts/publish.js",
    "test": "vitest",
    "test:ci": "vitest --coverage",
    "typecheck": "pnpm run --recursive typecheck",
    "validate": "run-p build lint format typecheck"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "@changesets/cli": "^2.31.1",
    "@manypkg/get-packages": "^3.0.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chalk": "^6.0.0",
    "jsonfile": "^6.2.1",
    "junit": "^1.4.9",
    "pkg-pr-new": "^0.0.80",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-sort-package-json": "^1.1.0",
    "prompt-confirm": "^2.0.4",
    "semver": "^7.8.5",
    "typedoc": "^0.28.20",
    "vitest": "catalog:",
    "wrangler": "^4.114.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
