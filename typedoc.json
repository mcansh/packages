{
  "$schema": "https://typedoc.org/schema.json",
  "readme": "./README.md",
  "name": "Packages",
  "entryPoints": ["packages/*"],
  "entryPointStrategy": "packages",
  "includeVersion": true,
  "json": "./public/dev/api.json",
  "out": "./public/dev",
  "hostedBaseUrl": "https://packages.mcan.sh/",
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "diff",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "shell",
    "tsx",
    "typescript"
  ]
}
