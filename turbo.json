{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "cache": false,
      "interactive": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format": {
      "with": ["format"]
    },
    "validate": {
      "with": ["build", "lint", "format", "typecheck"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
